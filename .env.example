SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///vowmotors.db
DEALERSHIP_NAME=Vow Motors

# Gmail SMTP settings for "forgot password" emails.
# MAIL_USERNAME is the full Gmail address that sends the emails.
# MAIL_PASSWORD must be a 16-character Gmail "App Password", not your normal
# Gmail password: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for the Google account)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=youraddress@gmail.com

# Production only: set these in the host's environment variables once HTTPS works.
# Do NOT set them locally, or login over http://127.0.0.1 will stop working.
# SECURE_COOKIES=true
# BEHIND_PROXY=true
